{
  "name": "slidev-theme-ie-fa",
  "version": "1.0.0",
  "private": true,
  "description": "تم دک‌های درس مهندسی اینترنت: پنجرهٔ مرورگر، فارسی، RTL، آفلاین",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=53.0.0"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "canvasWidth": 1280,
      "aspectRatio": "16/9",
      "routerMode": "hash",
      "selectable": true,
      "transition": "none",
      "colorSchema": "auto",
      "htmlAttrs": {
        "lang": "fa"
      },
      "fonts": {
        "sans": "Vazirmatn",
        "mono": "JetBrains Mono",
        "provider": "none"
      },
      "monaco": true,
      "monacoTypesSource": "none",
      "drawings": {
        "enabled": false
      },
      "browserExporter": true,
      "favicon": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230A6C86'/%3E%3Cpath d='M7 16h18' stroke='%23fff' stroke-width='3'/%3E%3C/svg%3E",
      "export": {
        "withClicks": true
      },
      "mdc": true
    }
  }
}